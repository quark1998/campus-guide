<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#F5F5F5"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="找回密码"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请输入您的学号及注册时的昵称进行身份验证"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp">
        <EditText
            android:id="@+id/et_reset_student_id"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:hint="请输入学号"
            android:paddingStart="16dp"
            android:inputType="text"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp">
        <EditText
            android:id="@+id/et_reset_nickname"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:hint="请输入注册时的昵称 (密保)"
            android:paddingStart="16dp"
            android:inputType="text"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="32dp">
        <EditText
            android:id="@+id/et_reset_new_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:hint="请输入新密码"
            android:paddingStart="16dp"
            android:inputType="textPassword"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_do_reset"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="确认重置密码"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF4C4C"
        app:cornerRadius="8dp"
        android:onClick="onResetClick" />

</LinearLayout>